SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Use an absolute path. The Docker Compose setup overrides this inside Airflow.
T2S_DUCKDB_PATH=/absolute/path/to/t2s_ecom/ingestion/medallion.duckdb

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local Airflow UI credentials. 
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
